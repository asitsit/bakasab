---
const links = [
  { label: 'Accueil', href: '/' },
  { label: 'À propos', href: '/a-propos' },
  { label: 'Missions', href: '/missions' },
  { label: 'Services', href: '/services' },
  { label: 'Contact', href: '/contact' },
];
---

<header class="nav" id="site-nav">
  <div class="nav-inner container">
    <a href="/" class="nav-logo">
      <span class="nav-logo-mark">//</span> BAKASAB
    </a>

    <nav class="nav-links" aria-label="Navigation principale">
      {links.map((link) => (
        <a class="nav-link" href={link.href}>
          <span class="nav-link-circle"></span>
          <span class="nav-link-text-wrap">
            <span class="nav-link-text-inner">
              <span class="nav-link-text">{link.label}</span>
              <span class="nav-link-text" aria-hidden="true">{link.label}</span>
            </span>
          </span>
        </a>
      ))}
    </nav>

    <button class="nav-menu-btn" id="nav-toggle" aria-label="Ouvrir le menu" aria-expanded="false">
      <span>//</span>
    </button>
  </div>
</header>

<div class="nav-overlay" id="nav-overlay">
  <nav class="nav-overlay-links" aria-label="Navigation mobile">
    {links.map((link, i) => (
      <a class="nav-overlay-link" href={link.href} style={`transition-delay:${i * 0.05}s`}>
        {link.label}
      </a>
    ))}
  </nav>
  <a href="/contact" class="btn btn-primary">Parlons de votre projet</a>
</div>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    color: var(--cream);
    background: transparent;
    transition: background-color 0.4s var(--ease-out), color 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out);
  }

  .nav.is-scrolled {
    background: color-mix(in srgb, var(--cream) 92%, transparent);
    backdrop-filter: blur(10px);
    color: var(--ink);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--ink) 10%, transparent);
  }

  .nav-inner {
    display: flex;
    align-items: stretch;
    gap: var(--space-lg);
    padding-block: 18px 0;
  }

  .nav-logo,
  .nav-link,
  .nav-menu-btn {
    border-bottom: 1px solid color-mix(in srgb, currentColor 35%, transparent);
    padding-bottom: 16px;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    margin-right: auto;
  }

  .nav-logo-mark {
    /* Cream (not orange) while floating over the hero: some page heroes are
       an orange-to-beige gradient, where an orange mark would disappear. */
    color: currentColor;
    margin-right: 6px;
  }

  .nav.is-scrolled .nav-logo-mark {
    color: var(--orange);
  }

  .nav-links {
    display: flex;
    gap: var(--space-lg);
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-weight: 600;
    font-size: var(--text-sm);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .nav-link-circle {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1px solid currentColor;
    flex-shrink: 0;
  }

  .nav-link-text-wrap {
    display: block;
    overflow: hidden;
    height: 1.3em;
  }

  .nav-link-text-inner {
    display: flex;
    flex-direction: column;
    transition: transform 0.45s var(--ease-out);
  }

  .nav-link-text {
    display: block;
    line-height: 1.3em;
    height: 1.3em;
  }

  .nav-link:hover .nav-link-text-inner {
    transform: translateY(-1.3em);
  }

  .nav-menu-btn {
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: -0.05em;
    padding-inline: 4px 2px;
    transition: transform 0.3s var(--ease-out);
  }

  .nav-menu-btn:hover {
    transform: rotate(90deg);
  }

  @media (max-width: 900px) {
    .nav-links {
      display: none;
    }
  }

  .nav-overlay {
    position: fixed;
    inset: 0;
    z-index: 105;
    background: var(--ink);
    color: var(--cream);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-xl);
    clip-path: circle(0% at 100% 0%);
    transition: clip-path 0.6s var(--ease-in-out);
    pointer-events: none;
  }

  .nav-overlay.is-open {
    clip-path: circle(150% at 100% 0%);
    pointer-events: auto;
  }

  .nav-overlay-links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  .nav-overlay-link {
    font-size: clamp(1.75rem, 6vw, 2.75rem);
    font-weight: 800;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.4s var(--ease-out), transform 0.4s var(--ease-out);
  }

  .nav-overlay.is-open .nav-overlay-link {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const nav = document.getElementById('site-nav');
  const toggle = document.getElementById('nav-toggle');
  const overlay = document.getElementById('nav-overlay');

  const onScroll = () => {
    nav?.classList.toggle('is-scrolled', window.scrollY > 40);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  toggle?.addEventListener('click', () => {
    const isOpen = overlay?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
    document.body.style.overflow = isOpen ? 'hidden' : '';
  });

  overlay?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      overlay.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    });
  });
</script>
