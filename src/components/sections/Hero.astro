---
---

<section class="hero">
  <div class="container hero-inner">
    <h1 class="hero-title" data-reveal-text>BAKASAB</h1>

    <div class="hero-body">
      <div class="hero-copy">
        <p class="hero-subtitle" data-reveal>
          On conçoit et on anime les temps forts qui font avancer les entreprises.
        </p>
        <a href="/contact" class="btn btn-primary" data-reveal>Parlons de votre projet</a>
      </div>

      <p class="hero-text" data-reveal>
        Séminaires, Digital, Formation. Une agence d'expériences pour les entreprises,
        en France et à l'international.
      </p>
    </div>
  </div>
</section>

<style>
  /* Same height/background formula as PageHero so every page opens on a
     header of matching height. */
  .hero {
    min-height: clamp(520px, 58vw, 760px);
    display: flex;
    align-items: center;
    padding-block: 130px var(--space-3xl);
    background: radial-gradient(ellipse at center, var(--orange) 0%, var(--orange-dim) 45%, var(--bordeaux) 100%);
    color: var(--cream);
  }

  .hero-inner {
    width: 100%;
  }

  .hero-title {
    font-size: clamp(4.5rem, 1vw + 13.5vw, 14rem);
    line-height: 0.82;
    letter-spacing: -0.03em;
    margin-block: 0 var(--space-lg);
    color: var(--cream);
    text-align: center;
  }

  .hero-body {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-2xl);
    align-items: start;
    padding-top: var(--space-lg);
    border-top: 1px solid color-mix(in srgb, var(--cream) 25%, transparent);
  }

  .hero-subtitle {
    font-size: clamp(1.4rem, 0.9rem + 1.4vw, 2.1rem);
    font-weight: 800;
    line-height: var(--lh-snug);
    max-width: 32ch;
    text-transform: uppercase;
  }

  .hero-text {
    max-width: 42ch;
    opacity: 0.85;
    font-size: var(--text-sm);
    text-transform: uppercase;
  }

  .btn.btn-primary {
    margin-top: var(--space-md);
    background: var(--cream);
    color: var(--ink);
  }

  .btn.btn-primary:hover {
    background: var(--ink);
    color: var(--cream);
  }

  @media (max-width: 900px) {
    .hero-title {
      font-size: clamp(3.25rem, 5vw + 8vw, 6rem);
    }
    .hero-body {
      grid-template-columns: 1fr;
    }
  }
</style>
