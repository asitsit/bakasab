---
interface Props {
  topText: string;
  bottomText: string;
  ctaLabel: string;
  ctaHref?: string;
}

const { topText, bottomText, ctaLabel, ctaHref = '/contact' } = Astro.props;

const repeatedTop = `${topText} `.repeat(6);
const repeatedBottom = `${bottomText} `.repeat(6);
---

<section class="cta-marquee">
  <div class="cta-marquee-stack">
    <div class="cta-marquee-track cta-marquee-track-left" aria-hidden="true">
      <div class="cta-marquee-track-inner">
        <span>{repeatedTop}</span>
        <span>{repeatedTop}</span>
      </div>
    </div>
    <div class="cta-marquee-track cta-marquee-track-right" aria-hidden="true">
      <div class="cta-marquee-track-inner cta-marquee-track-inner-outline">
        <span>{repeatedBottom}</span>
        <span>{repeatedBottom}</span>
      </div>
    </div>

    <div class="cta-marquee-content" data-reveal>
      <a href={ctaHref} class="cta-marquee-cta">
        <span>{ctaLabel}</span>
        <span class="cta-marquee-cta-arrow" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .cta-marquee {
    background: var(--cream);
    color: var(--ink);
    padding-block: var(--space-3xl);
    overflow: hidden;
  }

  .cta-marquee-stack {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    width: 100%;
    min-width: 0;
  }

  .cta-marquee-track {
    display: flex;
    overflow: hidden;
    width: 100%;
    min-width: 0;
  }

  .cta-marquee-track-inner {
    display: flex;
    flex-shrink: 0;
    width: max-content;
    animation: cta-marquee-scroll-right 34s linear infinite;
  }

  .cta-marquee-track-right .cta-marquee-track-inner {
    animation-name: cta-marquee-scroll-left;
  }

  .cta-marquee-track-inner span {
    font-size: clamp(2.625rem, 7.5vw, 6rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    padding-right: 0.4em;
    color: color-mix(in srgb, var(--ink) 35%, transparent);
  }

  .cta-marquee-track-inner-outline span {
    color: transparent;
    -webkit-text-stroke: 1.5px color-mix(in srgb, var(--ink) 25%, transparent);
  }

  @keyframes cta-marquee-scroll-left {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @keyframes cta-marquee-scroll-right {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-marquee-track-inner {
      animation: none;
    }
  }

  .cta-marquee-content {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cta-marquee-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    background: var(--orange);
    color: var(--ink);
    font-weight: 800;
    font-size: clamp(1.1rem, 2.6vw, 1.5rem);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    white-space: nowrap;
    padding: var(--space-sm) var(--space-sm) var(--space-sm) var(--space-lg);
    border-radius: 999px;
    transition: transform 0.3s var(--ease-out);
  }

  .cta-marquee-cta:hover {
    transform: scale(1.04);
  }

  .cta-marquee-cta-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: clamp(2.2rem, 5vw, 3rem);
    height: clamp(2.2rem, 5vw, 3rem);
    border-radius: 50%;
    background: var(--ink);
    color: var(--cream);
  }

  .cta-marquee-cta-arrow svg {
    width: 45%;
    height: 45%;
  }
</style>
