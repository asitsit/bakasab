---
import { Image } from 'astro:assets';
import alexandrePhoto from '../../assets/team/alexandre-sitbon.jpg';

const slugify = (name) =>
  name
    .toLowerCase()
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .replace(/\s+/g, '-');

const team = [
  { name: 'Clémence Macary', role: 'Design & gestion de projets' },
  { name: 'Ronan Broussier', role: 'Facilitation, technologie & IA' },
  { name: 'Marine Bourgeaud', role: 'Gestion de projet & DISC' },
  { name: 'Philip Boisvieux', role: 'Facilitation & projets collectifs' },
].map((member) => ({ ...member, image: `team/${slugify(member.name)}.jpg` }));
---

<section class="team section">
  <div class="container">
    <p class="eyebrow" data-reveal>Notre équipe</p>
    <h2 data-reveal>Un collectif, pas un carnet d'adresses.</h2>
    <p class="team-intro" data-reveal>
      BAKASAB est un réseau d'experts en formation, facilitation et design, engagés à créer des
      expériences collaboratives qui marquent. Chaque mission est co-construite avec vous, en
      mobilisant les bons profils selon vos enjeux, de 15 à 1000 participants, en présentiel,
      en ligne ou en hybride.
    </p>

    <div class="founder" data-reveal>
      <div class="founder-photo">
        <Image src={alexandrePhoto} alt="Alexandre Sitbon, fondateur de BAKASAB" width={640} height={760} />
      </div>
      <div class="founder-copy">
        <h3>Alexandre Sitbon</h3>
        <p class="founder-role">Fondateur, Facilitation & innovation</p>
      </div>
    </div>

    <div class="network">
      <p class="eyebrow network-eyebrow" data-reveal>Le réseau BAKASAB</p>

      <div class="team-grid" data-reveal-parent>
        {team.map((member) => (
          <div class="team-member" data-reveal data-reveal-group="team">
            <div class="team-member-photo" aria-hidden="true">
              <span class="placeholder-filename">→ à uploader :<br />src/assets/{member.image}</span>
            </div>
            <p class="team-member-name">{member.name}</p>
            <p class="team-member-role">{member.role}</p>
          </div>
        ))}
      </div>

      <blockquote class="network-quote" data-reveal>
        « Je ne gère pas un carnet d'adresses. Je choisis, mission après mission, le bon profil
        pour vous. »
        <cite>— Alexandre Sitbon, fondateur</cite>
      </blockquote>
    </div>
  </div>
</section>

<style>
  .team h2 {
    font-size: var(--text-h2);
    margin-top: var(--space-md);
    max-width: 20ch;
  }

  .team-intro {
    margin-top: var(--space-lg);
    font-size: var(--text-lg);
    max-width: 62ch;
    opacity: 0.8;
  }

  .founder {
    margin-top: var(--space-3xl);
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: var(--space-2xl);
    align-items: center;
  }

  .founder-photo {
    height: clamp(280px, 30vw, 420px);
    border-radius: var(--radius-lg);
    background: var(--bordeaux);
    overflow: hidden;
  }

  .founder-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .founder-copy h3 {
    font-size: var(--text-h3);
  }

  .founder-role {
    font-weight: 600;
    color: var(--orange);
    margin-top: var(--space-2xs);
  }

  .network {
    margin-top: var(--space-3xl);
  }

  .network-eyebrow {
    margin-bottom: var(--space-md);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
  }

  .network-quote {
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
    max-width: 52ch;
    font-weight: 600;
    font-size: var(--text-h4);
    line-height: var(--lh-snug);
    font-style: italic;
  }

  .network-quote cite {
    display: block;
    margin-top: var(--space-sm);
    font-style: normal;
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--orange);
  }

  .team-member {
    min-width: 0;
  }

  .team-member-photo {
    height: 170px;
    border-radius: var(--radius-md);
    background: var(--cream-dim);
    border: 1.5px solid color-mix(in srgb, var(--ink) 14%, transparent);
    margin-bottom: var(--space-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-sm);
  }

  .team-member-photo .placeholder-filename {
    color: color-mix(in srgb, var(--ink) 55%, transparent);
  }

  .team-member-name {
    font-weight: 800;
  }

  .team-member-role {
    font-size: var(--text-sm);
    opacity: 0.65;
  }

  @media (max-width: 900px) {
    .founder {
      grid-template-columns: 1fr;
    }
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
