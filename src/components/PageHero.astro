---
interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  intro?: string;
}

const { eyebrow, title, subtitle, intro } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    <p class="eyebrow" data-reveal-text>{eyebrow}</p>
    <h1 data-reveal-text>{title}</h1>
    {subtitle && <p class="page-hero-subtitle" data-reveal-text>{subtitle}</p>}
    {intro && <p class="page-hero-intro" data-reveal>{intro}</p>}
  </div>
</section>

<style>
  /* Same background as the home hero, and a fixed height so every page
     header matches the tallest one (À propos, eyebrow+title+subtitle+intro). */
  .page-hero {
    padding-top: 130px;
    padding-bottom: var(--space-3xl);
    min-height: clamp(520px, 58vw, 760px);
    display: flex;
    align-items: center;
    color: var(--cream);
    background: radial-gradient(ellipse at center, var(--orange) 0%, var(--orange-dim) 45%, var(--bordeaux) 100%);
  }

  .page-hero .container {
    width: 100%;
  }

  .page-hero .eyebrow {
    color: var(--cream);
    opacity: 0.85;
  }

  .page-hero h1 {
    font-size: var(--text-h2);
    line-height: var(--lh-tight);
    letter-spacing: -0.02em;
    margin-block: var(--space-md) var(--space-lg);
    max-width: 20ch;
    color: var(--cream);
  }

  .page-hero-subtitle {
    font-size: clamp(1.4rem, 0.9rem + 1.4vw, 2.1rem);
    font-weight: 700;
    line-height: var(--lh-snug);
    max-width: 40ch;
    opacity: 0.95;
  }

  .page-hero-intro {
    margin-top: var(--space-lg);
    font-size: var(--text-lg);
    max-width: 62ch;
    opacity: 0.85;
  }
</style>
