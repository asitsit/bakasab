---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ProFun from '../components/sections/ProFun.astro';
import MethodList from '../components/sections/MethodList.astro';
import Team from '../components/sections/Team.astro';
import Faq from '../components/Faq.astro';
import CtaMarquee from '../components/sections/CtaMarquee.astro';
import { org } from '../data/organization.js';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: org.founder.name,
  jobTitle: org.founder.role,
  worksFor: {
    '@type': 'Organization',
    name: org.name,
  },
  alumniOf: ['Centrale Lyon', 'emlyon business school'],
};

const faqItems = [
  {
    q: "Qu'est-ce que BAKASAB ?",
    a: "BAKASAB conçoit, anime et digitalise les temps forts qui comptent vraiment&nbsp;: séminaires, conventions, teambuildings, formations sur mesure. Fondée par Alexandre Sitbon, l'agence s'appuie sur un réseau d'experts en facilitation, design et technologie. De 15 à 1000 personnes, en France ou à l'international.",
  },
  {
    q: "En quoi BAKASAB est différent d'une agence événementielle classique ?",
    a: "Une agence événementielle classique gère la logistique. BAKASAB conçoit et anime l'expérience elle-même&nbsp;: facilitation, digitalisation, formation sur mesure, trois savoir-faire rarement réunis chez un seul prestataire. Un interlocuteur unique, du cadrage à la restitution.",
  },
  {
    q: 'Avec quels types d\'entreprises travaillez-vous ?',
    a: 'BAKASAB accompagne des entreprises de toutes tailles, des ETI en croissance aux grands groupes du CAC40. Même exigence, quelle que soit la taille. Parmi les organisations accompagnées&nbsp;: Danone, L\'Oréal, Safran, Vinci, Sanofi, RTE, Centrale Lyon, l\'EDHEC et Sciences Po.',
  },
  {
    q: 'Dans quels secteurs intervenez-vous ?',
    a: "Industrie, luxe, cosmétique, santé, pharma, énergie, BTP, grandes écoles&nbsp;: BAKASAB s'adapte à des enjeux métiers très différents grâce à un réseau d'experts multi-disciplinaires, plutôt qu'une spécialisation sectorielle unique.",
  },
  {
    q: 'Travaillez-vous à l\'international ?',
    a: 'Oui. En France comme à l\'international, en présentiel, digital ou hybride. BAKASAB a notamment piloté des groupes de travail RH dispersés sur plusieurs continents (mission Safran Carpe Diem, 6 mois).',
  },
  {
    q: 'Qui est Alexandre Sitbon, le fondateur de BAKASAB ?',
    a: "Le fondateur de BAKASAB. Diplômé de Centrale Lyon et de l'emlyon business school, il conçoit et anime des séminaires, formations et événements depuis plus de 5 ans, pour des entreprises allant de la start-up au CAC40. Avant BAKASAB, il organisait déjà des événements jusqu'à 3500 personnes.",
  },
  {
    q: 'Où voir les réalisations de BAKASAB ?',
    a: 'Sur la page <a href="/missions">Missions</a>&nbsp;: études de cas détaillées, comme la convention Vinci Building Solutions (360 participants) ou l\'accompagnement Safran Carpe Diem (DRH monde, 6 mois).',
  },
  {
    q: 'Quelles entreprises font confiance à BAKASAB ?',
    a: "Danone, L'Oréal, Safran, Vinci, Sanofi, RTE, et des établissements comme Centrale Lyon, l'EDHEC ou Sciences Po. Les témoignages nommés sont sur la page <a href=\"/missions\">Missions</a>.",
  },
  {
    q: 'Comment contacter BAKASAB ?',
    a: `Par email à <a href="mailto:${org.email}">${org.email}</a>, ou via le <a href="/contact">formulaire de contact</a>. L'agence est basée à ${org.address.city}, réponse sous 48h ouvrées.`,
  },
];
---

<BaseLayout
  title="À propos - BAKASAB, agence d'expériences pour les entreprises"
  description="BAKASAB est une agence d'expériences fondée par Alexandre Sitbon : un réseau d'experts en facilitation, design et digital qui conçoit et anime les temps forts collectifs des entreprises."
>
  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </Fragment>

  <PageHero
    eyebrow="Notre histoire"
    title="Une agence, un réseau, une seule obsession."
    subtitle="Faire que vos temps forts collectifs marquent vraiment les esprits, pas juste remplir un agenda."
    intro="BAKASAB est une agence d'expériences qui conçoit, anime et digitalise les temps forts collectifs des entreprises&nbsp;: séminaires, conventions, teambuildings et formations sur mesure. Fondé par Alexandre Sitbon, BAKASAB s'appuie sur un réseau d'experts en facilitation, design et technologie pour accompagner des groupes de 15 à 1000 personnes, en France et à l'international."
  />

  <section class="section about-vision">
    <div class="container">
      <p class="eyebrow" data-reveal>Notre vision</p>
      <h2 data-reveal>
        On ne vend pas un événement. On construit un moment que vos équipes racontent encore six
        mois après.
      </h2>
      <p class="about-vision-text" data-reveal>
        BAKASAB conçoit, anime et digitalise les temps forts collectifs des entreprises. Pas de
        logistique pure, pas de formation catalogue&nbsp;: une agence d'expériences qui pense chaque
        moment comme un levier d'engagement, du cadrage stratégique au dernier applaudissement.
      </p>
    </div>
  </section>

  <ProFun />
  <MethodList />
  <Team />

  <Faq
    eyebrow="L'agence, en questions"
    title="Ce qu'on nous demande le plus souvent"
    items={faqItems}
    tone="beige"
  />

  <CtaMarquee
    topText="Envie de nous rencontrer avant de vous lancer ?"
    bottomText={org.email}
    ctaLabel="Discutons de votre projet"
  />
</BaseLayout>

<style>
  .about-vision h2 {
    font-size: var(--text-h3);
    margin-block: var(--space-md) var(--space-xl);
    max-width: 24ch;
    color: var(--bordeaux);
  }

  .about-vision-text {
    font-size: var(--text-lg);
    max-width: 62ch;
    opacity: 0.8;
  }
</style>
