---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SimpleCta from '../../components/SimpleCta.astro';
import { missions } from '../../data/missions.js';
---

<BaseLayout
  title="Missions - Études de cas BAKASAB"
  description="Conventions, groupes de travail DRH, kick-offs de formation : les missions BAKASAB menées pour Vinci, Safran et d'autres organisations exigeantes, de 15 à 1000 participants."
>
  <PageHero
    eyebrow="Nos références"
    title="La preuve par le terrain."
    subtitle="Des organisations exigeantes, grands groupes ou en croissance, qui reviennent."
  />

  <section class="missions-intro section">
    <div class="container">
      <p class="missions-intro-text" data-reveal>
        On a conçu et animé des conventions de plusieurs centaines de personnes, des groupes de travail DRH sur 6
        mois, des kick-offs de formation pour de nouveaux managers. Chaque mission ci-dessous est
        une combinaison différente de nos trois expériences&nbsp;: collective, digitale, apprenante.
      </p>

      <div class="missions-grid">
        {missions.map((m) => (
          <a href={`/missions/${m.slug}`} class="mission-card" data-type={m.type}>
            <div class="mission-card-media" style={`background: linear-gradient(150deg, ${m.accent}, color-mix(in srgb, ${m.accent} 35%, var(--cream)))`}>
              <span class="mission-card-tag">{m.tag}</span>
            </div>
            <h2>{m.client}</h2>
            <p>{m.summary}</p>
            <span class="mission-card-link">En savoir plus →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <SimpleCta title="Votre prochain temps fort mérite le même traitement." buttonLabel="Parlons-en" />
</BaseLayout>

<style>
  .missions-intro-text {
    font-size: var(--text-lg);
    max-width: 68ch;
    opacity: 0.8;
    margin-bottom: var(--space-2xl);
  }

  .missions-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-xl);
  }

  .mission-card {
    display: block;
  }

  .mission-card-media {
    height: 240px;
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    display: flex;
    align-items: flex-start;
    margin-bottom: var(--space-md);
  }

  .mission-card-tag {
    font-weight: 600;
    font-size: var(--text-xs);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--cream);
    background: color-mix(in srgb, var(--ink) 45%, transparent);
    padding: 8px 14px;
    border-radius: var(--radius-sm);
  }

  .mission-card h2 {
    font-size: var(--text-h4);
    margin-bottom: var(--space-xs);
  }

  .mission-card p {
    opacity: 0.75;
    max-width: 46ch;
    margin-bottom: var(--space-sm);
  }

  .mission-card-link {
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--orange);
    transition: transform 0.3s var(--ease-out);
    display: inline-block;
  }

  .mission-card:hover .mission-card-link {
    transform: translateX(4px);
  }

  @media (max-width: 767px) {
    .missions-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
